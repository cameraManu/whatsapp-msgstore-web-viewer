# --- Docker Compose ---
# Host folder containing your entire WhatsApp export/backup \u2014 the PARENT
# folder that has Backups/, Media/, Databases/ etc. inside it (e.g.
# ".../WhatsApp2/WhatsApp"). Docker Compose reads this automatically from a
# file literally named ".env" next to docker-compose.yml, and bind-mounts it
# read-only into the container at /backup.
#
# The server scans this folder recursively for a .db/.crypt12/14/15 file, and
# separately looks for a "Media" subfolder inside it (WhatsApp's normal
# layout) to resolve photos/videos/audio/documents referenced by messages.
#
# Use forward slashes even on Windows.
# Example: WA_BACKUP_HOST_DIR=C:/Users/YourName/Documents/WhatsAppBackup
WA_BACKUP_HOST_DIR=

# Your 64-character hex WhatsApp E2E backup recovery key. Required only if
# the backup file is encrypted (.crypt12/.crypt14/.crypt15). Leave blank for
# a plain, unencrypted .db file.
WA_BACKUP_KEY_HEX=

# --- Local (non-Docker) server development only ---
# Same as WA_BACKUP_HOST_DIR above, but used when running the server directly
# on the host via `npm run server:dev` (no Docker). Use your OS's normal path
# format here (e.g. a plain Windows path is fine for this one).
WA_BACKUP_DIR=

# --- Advanced (rarely needed) ---
# Only set this if your Media folder is NOT a "Media" subfolder inside
# WA_BACKUP_DIR/WA_BACKUP_HOST_DIR \u2014 e.g. it lives in a completely separate
# location. Leave blank otherwise; it's auto-detected.
WA_MEDIA_HOST_DIR=
WA_MEDIA_DIR=
