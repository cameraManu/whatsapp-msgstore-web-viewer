# Path to a local folder containing your WhatsApp backup files
# (msgstore.db, msgstore.db.crypt12/14/15, and/or a key file).
#
# When set, `npm run dev` will let you open files directly from this folder
# in the app UI, instead of using the browser upload dialog every time.
#
# This only affects the local dev server (npm run dev). It has no effect on
# the production/GitHub Pages build, which has no backend.
#
# Windows example:
# WA_BACKUP_DIR=C:\Users\YourName\Documents\WhatsAppBackup
#
# macOS/Linux example:
# WA_BACKUP_DIR=/Users/yourname/WhatsAppBackup

WA_BACKUP_DIR=

# --- Docker Compose only ---
# Same folder as above, but used to bind-mount it into the container at
# /backup (see docker-compose.yml). Docker Compose reads this automatically
# from a file literally named ".env" next to docker-compose.yml.
# Use forward slashes even on Windows, e.g.:
# WA_BACKUP_HOST_DIR=C:/Users/YourName/Documents/WhatsAppBackup

WA_BACKUP_HOST_DIR=
